#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0 OR MIT
#
# Fails when any restatement of the package version disagrees with
# pyproject.toml, the single source of truth: uv.lock, CITATION.cff,
# CHANGELOG.md, the SECURITY.md and SUPPORT.md support tables and the
# bug report form. The package reads its version from the installed
# metadata, so code cannot drift. Once CHANGELOG.md dates the version,
# docs/releases/<version>.md (the release highlights) must exist. With
# --tag vX.Y.Z it also checks the tag names that version and that
# CHANGELOG.md dates it: an `## [<version>] - Unreleased` heading is fine
# on a branch, never at a release tag.
#
#   scripts/verify-release-versions
#   scripts/verify-release-versions --tag v0.0.22
set -euo pipefail

cd "$(dirname "$0")/.."

version="$(sed -n 's/^version = "\([^"]*\)"$/\1/p' pyproject.toml | head -n 1)"
name="$(sed -n 's/^name = "\([^"]*\)"$/\1/p' pyproject.toml | head -n 1)"
if [ -z "$version" ] || [ -z "$name" ]; then
  echo "verify-release-versions: no name or version in pyproject.toml" >&2
  exit 1
fi
failures=0

# expect FILE TEXT: FILE must contain TEXT, verbatim.
expect() {
  if ! grep -qF -- "$2" "$1"; then
    echo "verify-release-versions: $1 lacks: $2" >&2
    failures=$((failures + 1))
  fi
}

if ! grep -A1 -x "name = \"$name\"" uv.lock | grep -qx "version = \"$version\""; then
  echo "verify-release-versions: uv.lock does not lock $name $version" >&2
  failures=$((failures + 1))
fi
expect CITATION.cff "version: \"$version\""
expect SECURITY.md "| \`$version\` ("
expect SUPPORT.md "| \`$version\` ("
expect .github/ISSUE_TEMPLATE/bug_report.yml "placeholder: \"$version\""

tagged=false
if [ "${1:-}" = "--tag" ]; then
  tagged=true
  tag="${2:?--tag needs a value}"
  if [ "$tag" != "v$version" ]; then
    echo "verify-release-versions: tag $tag, but pyproject.toml says $version" >&2
    failures=$((failures + 1))
  fi
fi

if grep -qE "^## \[$version\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$" CHANGELOG.md; then
  if [ ! -f "docs/releases/$version.md" ]; then
    echo "verify-release-versions: CHANGELOG dates $version; docs/releases/$version.md is missing" >&2
    failures=$((failures + 1))
  fi
elif $tagged; then
  echo "verify-release-versions: CHANGELOG.md does not date $version (## [$version] - YYYY-MM-DD)" >&2
  failures=$((failures + 1))
elif ! grep -qx "## \[$version\] - Unreleased" CHANGELOG.md; then
  echo "verify-release-versions: CHANGELOG.md has neither [$version] - Unreleased nor a dated [$version]" >&2
  failures=$((failures + 1))
fi

if [ "$failures" -ne 0 ]; then
  echo "verify-release-versions: $failures mismatch(es) with $version" >&2
  exit 1
fi
echo "verify-release-versions: every restatement says $version"
