#
# codespell (docs-lint workflow). Skipped: environments, build output,
# licence texts, the lock file and the binary fuzz corpus.
[codespell]
skip = ./.git,./.venv,./dist,./site,./LICENSES,./uv.lock,./.mypy_cache,./.ruff_cache,./.hypothesis,./fuzz/corpus,./.fuzz-corpus
check-hidden = true
