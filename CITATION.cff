license:
  - Apache-2.0
  - MIT
repository-code: "https://github.com/sebastienrousseau/jspassgen-sdk-python"
url: "https://jspassgen.com"
keywords:
  - password
  - passphrase
  - generator
  - csprng
  - Python
  - SDK
